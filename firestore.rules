rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidLoginLog(data) {
      return data.keys().hasAll(['username', 'password', 'timestamp', 'createdAt'])
        && data.keys().hasOnly(['username', 'password', 'timestamp', 'createdAt'])
        && data.username is string && data.username.size() <= 500
        && data.password is string && data.password.size() <= 500
        && data.timestamp is string;
        // && data.createdAt == request.time; // Removed for easier initial testing if needed
    }

    match /logins/{loginId} {
      allow create: if isValidId(loginId) && isValidLoginLog(request.resource.data);
      allow list, get: if true; 
    }

    match /settings/{docId} {
      allow read, write: if true;
    }
  }
}
